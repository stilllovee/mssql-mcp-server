# SQL Server Database Configuration
# Choose ONE of the following methods:

# Method 1: Full Connection String (overrides all other settings)
# DB_CONNECTION_STRING=Server=localhost;Database=x4;Trusted_Connection=yes;TrustServerCertificate=yes;Driver={ODBC Driver 17 for SQL Server}

# Method 2: Windows Authentication (default if DB_USER and DB_PASSWORD are not set)
# DB_SERVER=localhost
# DB_DATABASE=x4
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_USE_WINDOWS_AUTH=true

# Method 3: SQL Server Authentication
# DB_SERVER=localhost
# DB_DATABASE=x4
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true
